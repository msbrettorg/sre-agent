        "dataSource": "placeholder",
        "extendedProperties": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@azure/mcp@latest",
            "server",
            "start",
            "--namespace",
            "kusto",
            "--read-only"
          ],
          "toolsVisibleToMetaAgent": [
            "*"
          ],
          "selectedTools": [
            "*"
          ]
        },
        "identity": "system"
      }
    }
  ]
